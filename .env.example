# Aegis Platform — Environment Variables
# Copy this to .env and fill in your values

# ─── Application ────────────────────────────────────────────────────────────
AEGIS_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-at-least-32-chars

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secret
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secret@localhost:5432/aegis
DATABASE_URL_SYNC=postgresql+psycopg2://aegis:aegis_secret@localhost:5432/aegis

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID_CORRELATOR=aegis-correlator
KAFKA_GROUP_ID_INVESTIGATOR=aegis-investigator
KAFKA_GROUP_ID_OUTBOX=aegis-outbox-publisher

# ─── Temporal ────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aegis-incident-workflow

# ─── AI / LLM ────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ─── Kubernetes ──────────────────────────────────────────────────────────────
KUBECONFIG=
KUBERNETES_IN_CLUSTER=false
AEGIS_K8S_ALLOWED_NAMESPACES=production,staging,demo,default
AEGIS_K8S_ALLOWED_DEPLOYMENTS=checkout,payment,inventory

# ─── Prometheus / Observability ──────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GRAFANA_URL=http://localhost:3000

# ─── Aegis Services ──────────────────────────────────────────────────────────
AEGIS_API_PORT=8000
AEGIS_INGESTOR_PORT=8001
CORRELATION_TIME_WINDOW_SECONDS=300
VERIFICATION_OBSERVATION_WINDOW_SECONDS=30

# ─── Demo Services ───────────────────────────────────────────────────────────
DEMO_POSTGRES_URL=postgresql://demo:demo_secret@localhost:5433/demo
DEMO_REDIS_URL=redis://localhost:6380/0
CHECKOUT_PORT=3001
PAYMENT_PORT=3002
INVENTORY_PORT=3003

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis
